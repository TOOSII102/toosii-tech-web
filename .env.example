# ── WhatsApp Bot ───────────────────────────────────────────────
# WhatsApp session prefix (default: TOOSII~)
SESSION_PREFIX=TOOSII~

# Support group invite code (optional)
SUPPORT_GROUP=

# ── Admin Dashboard ────────────────────────────────────────────
# BOTH of the following are REQUIRED for admin login to work.
# If either is missing (or ADMIN_SECRET is shorter than 16 characters)
# the admin area stays locked and /api/admin/login returns 503.
# There is intentionally NO default value — a fallback secret would let
# anyone forge an admin session cookie.

# Admin login password (only toosii042@gmail.com can log in)
ADMIN_PASSWORD=your-strong-password-here

# Secret used to sign admin session cookies. MUST be >= 16 characters.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=your-random-secret-at-least-16-chars

# Your site's public URL (used in reset email links)
NEXT_PUBLIC_SITE_URL=https://toosiitechdevelopertools.zone.id

# ── Email / SMTP (for password reset emails) ───────────────────
# Use a Gmail App Password — NOT your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=toosii042@gmail.com
SMTP_PASS=your-gmail-app-password-here

# ── Optional integrations ──────────────────────────────────────
# Raises the GitHub API rate limit for the admin dashboard stats
GITHUB_TOKEN=

# Vercel Web Analytics (admin visitor stats)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── AI chat providers (/api/chat, /tools/ai) ───────────────────
# Provide at least one; the route falls back across whatever is set.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# OMDb key used by movie fallbacks
OMDB_API_KEY=
