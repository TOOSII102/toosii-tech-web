# WhatsApp session prefix (default: TOOSII~)
  SESSION_PREFIX=TOOSII~

  # Support group invite code (optional)
  SUPPORT_GROUP=

  # ── Admin Dashboard ────────────────────────────────────────────
  # Admin login password (only toosii042@gmail.com can log in)
  ADMIN_PASSWORD=your-strong-password-here

  # Secret used for session cookies (generate a random string)
  ADMIN_SECRET=your-random-secret-here

  # Your site's public URL (used in reset email links)
  NEXT_PUBLIC_SITE_URL=https://toosiitechdevelopertools.zone.id

  # ── Email / SMTP (for password reset emails) ───────────────────
  # Use a Gmail App Password — NOT your regular Gmail password
  # Generate one at: https://myaccount.google.com/apppasswords
  SMTP_HOST=smtp.gmail.com
  SMTP_PORT=587
  SMTP_SECURE=false
  SMTP_USER=toosii042@gmail.com
  SMTP_PASS=your-gmail-app-password-here
  