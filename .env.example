# ── WhatsApp Bot ───────────────────────────────────────────────
# WhatsApp session prefix (default: TOOSII~)
SESSION_PREFIX=TOOSII~

# Support group invite code (optional)
SUPPORT_GROUP=

# ── Admin Dashboard ────────────────────────────────────────────
# Admin login password (only toosii042@gmail.com can log in)
ADMIN_PASSWORD=your-strong-password-here

# Secret used for admin session cookies.
#
# ⚠️  SET THIS. If it is left unset the code falls back to the hardcoded
#     value 'toosii-admin', and anyone who sends the cookie
#     `admin_token=toosii-admin` gets full access to /admin,
#     /api/admin/stats and /api/admin/visitors.
#
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=your-random-secret-here

# Your site's public URL (used in reset email links)
NEXT_PUBLIC_SITE_URL=https://toosiitechdevelopertools.zone.id

# ── Email / SMTP (for password reset emails) ───────────────────
# Use a Gmail App Password — NOT your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=toosii042@gmail.com
SMTP_PASS=your-gmail-app-password-here

# ── Optional integrations ──────────────────────────────────────
# Raises the GitHub API rate limit for the admin dashboard stats
GITHUB_TOKEN=

# Vercel Web Analytics (admin visitor stats)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── AI chat providers (/api/chat, /tools/ai) ───────────────────
# All OPTIONAL. Without any key, Toosii AI runs on free key-less providers
# (Qwen, DeepSeek V3/R1, Gemini via the public Kaalix endpoints — no key
# required) and Toosii Vision reads text from uploaded images for free.
# Set GEMINI_API_KEY (free: https://aistudio.google.com/apikey) or one of the
# keys below and image uploads get full scene understanding automatically.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# OMDb key used by movie fallbacks
OMDB_API_KEY=
