# WhatsApp session prefix (default: TOOSII~)
SESSION_PREFIX=TOOSII~

# Support group invite code (optional)
SUPPORT_GROUP=

  # Admin dashboard password — set a strong secret before deploying
  # Visit /admin to access the dashboard, /admin/login to sign in
  ADMIN_SECRET=change-me-to-a-strong-password

  # ── Admin Dashboard ────────────────────────────────────────────
  # Admin login credentials
  ADMIN_EMAIL=your-email@example.com
  ADMIN_PASSWORD=your-strong-password-here

  # Secret used for session cookies (generate a random string)
  ADMIN_SECRET=toosii-xd-2024-secret

  # Your site's public URL (used in reset email links)
  NEXT_PUBLIC_SITE_URL=https://toosiitechdevelopertools.zone.id

  # ── Email (for password reset) ─────────────────────────────────
  # Gmail: use an App Password (https://myaccount.google.com/apppasswords)
  SMTP_HOST=smtp.gmail.com
  SMTP_PORT=587
  SMTP_SECURE=false
  SMTP_USER=toosii042@gmail.com
  SMTP_PASS=your-Kenyan.222
  
